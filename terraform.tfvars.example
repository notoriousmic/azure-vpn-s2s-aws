# ==============================================================================
# Example Terraform Variables File
# ==============================================================================
# Copy this file to terraform.tfvars and update with your actual values.
# The terraform.tfvars file should NOT be committed to version control.
#
# Usage: cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# ------------------------------------------------------------------------------
# General Configuration
# ------------------------------------------------------------------------------

# AWS scenario: greenfield | transit_gateway | existing_vpc | existing_vpg
aws_scenario = "greenfield"

name_prefix = "azure-aws-vpn"
environment = "prod"

tags = {
  Owner       = "YourName"
  CostCenter  = "IT-Infrastructure"
  Department  = "Networking"
}

# ------------------------------------------------------------------------------
# Azure Configuration
# ------------------------------------------------------------------------------

azure_location = "West Europe"

azure_vnet_address_space    = ["10.1.0.0/16"]
azure_gateway_subnet_prefix = ["10.1.255.0/27"]
azure_availability_zones    = ["1", "2", "3"]

# Azure VPN Gateway
azure_vpn_gateway_sku        = "VpnGw2AZ"
azure_vpn_gateway_generation = "Generation2"
azure_bgp_asn                = 65000

# ------------------------------------------------------------------------------
# AWS Configuration — Greenfield (new VPC)
# ------------------------------------------------------------------------------

aws_region          = "us-east-1"
aws_vpc_cidr        = "10.2.0.0/16"
aws_vpn_gateway_asn = 64512

# ------------------------------------------------------------------------------
# AWS Configuration — Existing VPC (uncomment for existing_vpc / existing_vpg)
# ------------------------------------------------------------------------------

# aws_vpc_id       = "vpc-0123456789abcdef0"
# aws_route_table_id = "rtb-0123456789abcdef0"

# ------------------------------------------------------------------------------
# AWS Configuration — Existing VPG (uncomment for existing_vpg)
# ------------------------------------------------------------------------------

# aws_vpn_gateway_id = "vgw-0123456789abcdef0"

# ------------------------------------------------------------------------------
# AWS Configuration — Transit Gateway (uncomment for transit_gateway)
# ------------------------------------------------------------------------------

# aws_transit_gateway_id = "tgw-0123456789abcdef0"

# ------------------------------------------------------------------------------
# VPN Tunnel Pre-Shared Keys (required for all scenarios)
# ------------------------------------------------------------------------------
# Use a password generator: openssl rand -base64 32

tunnel1_instance0_psk = "CHANGE_ME_SecureRandomString1"
tunnel2_instance0_psk = "CHANGE_ME_SecureRandomString2"
tunnel1_instance1_psk = "CHANGE_ME_SecureRandomString3"
tunnel2_instance1_psk = "CHANGE_ME_SecureRandomString4"
# Notes
# ----------------------------------------------------------------------------
# 1. The BGP APIPA addresses are pre-configured in locals.tf and follow
#    the Azure-AWS VPN documentation standard
# 2. Total of 4 tunnels will be created (2 connections × 2 tunnels each)
# 3. VPN Gateway deployment takes approximately 30-45 minutes
# 4. Ensure your Azure and AWS credentials are configured before running
# ============================================================================
